# compose.usb.yaml用。1つのpixdサービスに1台を指定する。
# USBポート指定の例: PIX_DEVICE=usb:1-8.2
# シリアル指定はpixd-launchがLinux sysfsからUSBポートへ変換する。
PIX_DEVICE=serial:REPLACE_WITH_YOUR_SERIAL
# ホスト上の既存pix-userlandチェックアウトに含まれる標準ファームウェア。
# 必ず実在するファイルへの絶対パスを設定する。
PIX_FIRMWARE_FILE=/absolute/path/to/pix-userland/firmware/dt295.bin
MIRAKC_PORT=40772
